{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map_resource_manifest.schema.json",
  "title": "China2 Remake Map Resource Manifest",
  "type": "object",
  "required": ["schema_version", "generated_from", "banks", "layers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_from": {
      "type": "object",
      "required": ["workspace_root", "tool", "evidence_policy"],
      "additionalProperties": false,
      "properties": {
        "workspace_root": {"type": "string"},
        "tool": {"type": "string"},
        "evidence_policy": {"type": "string"}
      }
    },
    "banks": {
      "type": "array",
      "items": {"$ref": "#/$defs/bank"}
    },
    "layers": {
      "type": "array",
      "items": {"$ref": "#/$defs/layer"}
    }
  },
  "$defs": {
    "evidence_level": {
      "type": "string",
      "enum": [
        "confirmed_original",
        "strong_inference",
        "weak_inference",
        "remake_design"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["active", "probe", "blocked", "remake_design"]
    },
    "bank": {
      "type": "object",
      "required": [
        "id",
        "source_path",
        "format",
        "group_count",
        "evidence_level"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "source_path": {"type": "string"},
        "format": {"type": "string"},
        "group_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string"},
        "evidence_level": {"$ref": "#/$defs/evidence_level"},
        "notes": {"type": "string"}
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "canonical_layer",
        "evidence_level",
        "status",
        "source_refs",
        "draw_order"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "canonical_layer": {
          "type": "string",
          "enum": [
            "terrain_base",
            "terrain_detail",
            "resources",
            "roads",
            "cities",
            "armies",
            "fog_visibility",
            "editor_markers"
          ]
        },
        "evidence_level": {"$ref": "#/$defs/evidence_level"},
        "status": {"$ref": "#/$defs/status"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "source_bank": {"type": "string"},
        "source_group_expr": {"type": "string"},
        "tile_field_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "record_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "draw_order": {"type": "integer"},
        "draw": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tile_step_x": {"type": "integer"},
            "tile_step_y": {"type": "integer"},
            "pivot_x": {"type": "integer"},
            "pivot_y": {"type": "integer"},
            "y_adjust": {"type": "integer"},
            "blend": {"type": "string"},
            "animation": {"type": "string"}
          }
        },
        "notes": {"type": "string"}
      }
    }
  }
}
